{
  "name": "blog-tp3",
  "version": "1.0.0",
  "description": "Blog complet avec authentification, gestion d'articles et base de données MySQL",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "nodemon --env-file=.env server.js",
    "migrate": "npx sequelize db:migrate",
    "seed": "npx sequelize db:seed:all"
  },
  "keywords": [
    "blog",
    "express",
    "sequelize",
    "jwt",
    "authentication"
  ],
